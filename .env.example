# Hostinger FTP — encontre em hPanel > Arquivos > Contas FTP
HOSTINGER_FTP_HOST=ftp.reformacaseira.com.br
HOSTINGER_FTP_USER=u123456789
HOSTINGER_FTP_PASS=
HOSTINGER_FTP_DIR=/public_html

# Mercado Livre Afiliados — encontre em mercadolivre.com.br/afiliados > Configurações
ML_AFFILIATE_ID=

# ML Developer App — cadastre em developers.mercadolivre.com.br
ML_APP_ID=
ML_SECRET_KEY=

# Hotmart — link de afiliado dos cursos (ex.: elétrica básica, hidráulica/encanador, marcenaria)
HOTMART_AFFILIATE_LINK=
