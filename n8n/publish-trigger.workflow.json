        "chatId": "REPLACE_CHAT_ID",
        "text": "=⚠️ *Reforma Caseira* — publicação do post de {{ $now.format('dd/MM/yyyy') }} FALHOU mesmo após retry.\n\nÚltimo run: {{ $json.workflow_runs[0].html_url }}\nConclusão: {{ $json.workflow_runs[0].conclusion }}\n\nProvável timeout de FTP na Hostinger. Rode o workflow manualmente ou verifique a Hostinger.",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "node-telegram",
      "name": "Alertar no Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1940,
        500
      ],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram Bot"
        }
      }
    }
  ],
