{
  "name": "Reforma Caseira — Publicar posts (07h BRT)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 7 * * *"
            }
          ]
        }
      },
      "id": "node-schedule",
      "name": "07h BRT (diário)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -100,
        300
      ],
      "notes": "n8n usa cron de 6 campos (Segundo Minuto Hora Dia Mes DiaSemana). '0 0 7 * * *' = 07:00:00. Timezone da workflow = America/Sao_Paulo (Settings da workflow). Se preferir UTC, use '0 0 10 * * *'."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/marciocosta1379/reforma-caseira/actions/workflows/publish-scheduled.yml/dispatches",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "X-GitHub-Api-Version", "value": "2022-11-28" },
            { "name": "User-Agent", "value": "n8n-reformacaseira" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"ref\": \"main\"\n}",
        "options": {}
      },
      "id": "node-dispatch-1",
      "name": "Disparar workflow (1ª)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        140,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_CREDENTIAL_ID",
          "name": "GitHub PAT (Bearer)"
        }
      }
    },
    {
      "parameters": {
        "amount": 180,
        "unit": "seconds"
      },
      "id": "node-wait-1",
      "name": "Esperar 3 min",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        360,
        300
      ],
      "webhookId": "reforma-wait-1"
    },
    {
      "parameters": {
        "url": "https://api.github.com/repos/marciocosta1379/reforma-caseira/actions/runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "X-GitHub-Api-Version", "value": "2022-11-28" },
            { "name": "User-Agent", "value": "n8n-reformacaseira" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "event", "value": "workflow_dispatch" },
            { "name": "per_page", "value": "1" }
          ]
        },
        "options": {}
      },
      "id": "node-getrun-1",
      "name": "Conferir run (1ª)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        580,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_CREDENTIAL_ID",
          "name": "GitHub PAT (Bearer)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.workflow_runs[0].conclusion }}",
              "rightValue": "success",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "node-if-1",
      "name": "Publicou?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        800,
        300
      ]
    },
    {
      "parameters": {},
      "id": "node-ok-1",
      "name": "OK (1ª tentativa)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1040,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/marciocosta1379/reforma-caseira/actions/workflows/publish-scheduled.yml/dispatches",
