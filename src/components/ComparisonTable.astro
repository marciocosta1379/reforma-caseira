---
import AffiliateButton from './AffiliateButton.astro';

type Store = 'mercadolivre' | 'amazon' | 'hotmart';

interface StoreLink {
  store: Store;
  url: string;
}

interface Row {
  name: string;
  brand?: string;
  price?: number;
  rating?: number;
  highlight?: string;
  /** Especificação-chave da comparação (tensão, capacidade, potência...). A coluna
   *  só aparece quando pelo menos uma linha traz o campo. */
  spec?: string;
  /** Variante equivalente do mesmo produto (ex.: a versão em outra tensão).
   *  Vira um link logo abaixo da especificação. */
  altUrl?: string;
  altLabel?: string;
  stores?: StoreLink[];
  affiliateUrl?: string;
  store?: Store;
}

interface Props {
  rows: Row[];
  source?: string;
  priceDate?: string;
  /** Cabeçalho da coluna de especificação. Padrão: "Especificação". */
  specLabel?: string;
}

const { rows, source, priceDate, specLabel = 'Especificação' } = Astro.props;

// Detecta a loja pela URL quando a linha usa o formato antigo (affiliateUrl solto).
const storeFromUrl = (url: string): Store =>
  /amazon\./i.test(url) ? 'amazon' : /hotmart\./i.test(url) ? 'hotmart' : 'mercadolivre';

const storeLinksOf = (r: Row): StoreLink[] =>
  r.stores && r.stores.length > 0
    ? r.stores
    : r.affiliateUrl
      ? [{ store: r.store ?? storeFromUrl(r.affiliateUrl), url: r.affiliateUrl }]
      : [];

const fmt = (n?: number) =>
  n ? new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(n) : '—';

// Esconde colunas sem dado em nenhuma linha (a Amazon não permite exibir preço,
// então em posts 100% Amazon a coluna Preço não deve aparecer vazia).
const showRating = rows.some((r) => typeof r.rating === 'number');
const showPrice = rows.some((r) => typeof r.price === 'number');
const showSpec = rows.some((r) => typeof r.spec === 'string' && r.spec.length > 0);
---

<div class="comparison-wrap">
  <table class="comparison">
    <thead>
      <tr>
        <th scope="col">Produto</th>
        {showSpec && <th scope="col">{specLabel}</th>}
        <th scope="col">Destaque</th>
        {showRating && <th scope="col">Nota</th>}
        {showPrice && <th scope="col">Preço</th>}
        <th scope="col"><span class="visually-hidden">Comprar</span></th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr>
            <th scope="row">
              <strong>{r.name}</strong>
              {r.brand && <span class="comparison__brand"> · {r.brand}</span>}
            </th>
            {showSpec && (
              <td class="comparison__spec">
                {r.spec ?? '—'}
                {r.altUrl && r.altLabel && (
                  <a
                    class="comparison__alt"
                    href={r.altUrl}
                    target="_blank"
                    rel="sponsored nofollow noopener noreferrer"
                  >
                    {r.altLabel} →
                  </a>
                )}
              </td>
            )}
            <td>{r.highlight ?? '—'}</td>
            {showRating && <td>{r.rating ? `⭐ ${r.rating.toFixed(1)}` : '—'}</td>}
            {showPrice && <td>{fmt(r.price)}</td>}
            <td>
              <div class="comparison__actions">
                {storeLinksOf(r).map((s) => (
                  <AffiliateButton href={s.url} store={s.store} source={source} />
                ))}
              </div>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
  {showPrice && priceDate && (
    <p class="comparison__pricenote">💲 Preços consultados em {priceDate}, sujeitos a alteração. Confira o valor atual na loja.</p>
  )}
</div>

<style>
  .comparison__spec { white-space: nowrap; font-weight: 700; }
  .comparison__alt {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .comparison__actions { display: flex; flex-direction: column; gap: 0.4rem; align-items: stretch; }
  .comparison__pricenote {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0.6rem 0 0;
  }
</style>
