---
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Receba novos reviews e ofertas por e-mail',
  text = 'As melhores ferramentas e ofertas direto no seu e-mail. Sem spam — cancele quando quiser.',
} = Astro.props;

// Endpoint do formulário MailerLite (conta 2398596)
const ACTION = 'https://assets.mailerlite.com/jsonp/2398596/forms/189124149963129945/subscribe';
---

<section class="newsletter">
  <div class="newsletter__inner">
    <div class="newsletter__head">
      <h3 class="newsletter__title">{title}</h3>
      <p class="newsletter__text">{text}</p>
    </div>

    <form class="newsletter__form js-newsletter" action={ACTION} method="post">
      <div class="newsletter__row">
        <input
          type="email"
          name="fields[email]"
          required
          placeholder="Seu melhor e-mail"
          aria-label="Seu e-mail"
          autocomplete="email"
          class="newsletter__input"
        />
        <button type="submit" class="newsletter__btn">Quero receber</button>
      </div>

      <label class="newsletter__consent">
        <input type="checkbox" required />
        <span>
          Concordo em receber e-mails do Reforma Caseira e li a
          <a href="/politica-privacidade/">Política de Privacidade</a>.
        </span>
      </label>

      <input type="hidden" name="ml-submit" value="1" />
      <input type="hidden" name="anticsrf" value="true" />

      <p class="newsletter__msg" role="status" hidden></p>
    </form>
  </div>
</section>

<script>
  document.querySelectorAll('.js-newsletter').forEach((form) => {
    const f = form as HTMLFormElement;
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = f.querySelector('.newsletter__btn') as HTMLButtonElement;
      const msg = f.querySelector('.newsletter__msg') as HTMLElement;
      const original = btn.textContent;

      btn.disabled = true;
      btn.textContent = 'Enviando...';

      try {
        await fetch(f.action, {
          method: 'POST',
          body: new URLSearchParams(new FormData(f) as any),
          mode: 'no-cors',
        });
      } catch (_) {
        /* no-cors: resposta opaca, ignoramos */
      }

      f.reset();
      btn.disabled = false;
      btn.textContent = original;
      msg.hidden = false;
      msg.textContent =
        'Quase lá! Enviamos um e-mail de confirmação — clique no link para concluir sua inscrição.';
    });
  });
</script>

<style>
  .newsletter {
    background: var(--color-dark);
    padding: 3rem 1.5rem;
  }
  .newsletter__inner {
    max-width: var(--container-prose);
    margin: 0 auto;
    text-align: center;
  }
  .newsletter__title {
    color: #fff;
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
  }
  .newsletter__text {
    color: rgba(255, 255, 255, 0.7);
    margin: 0 auto 1.75rem;
    max-width: 440px;
    font-size: 1rem;
    line-height: 1.6;
  }
  .newsletter__form {
    max-width: 480px;
    margin: 0 auto;
  }
  .newsletter__row {
    display: flex;
    gap: 0.5rem;
  }
  .newsletter__input {
    flex: 1;
    padding: 0.8rem 1rem;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    font-size: 1rem;
    font-family: inherit;
  }
  .newsletter__input:focus {
    outline: 2px solid var(--color-orange);
    outline-offset: 1px;
  }
  .newsletter__btn {
    flex-shrink: 0;
    padding: 0.8rem 1.4rem;
    background: var(--color-orange);
    color: #fff;
    border: none;
    border-radius: var(--radius-md);
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s;
  }
  .newsletter__btn:hover:not(:disabled) {
    background: var(--color-orange-hover);
  }
  .newsletter__btn:disabled {
    opacity: 0.7;
    cursor: default;
  }
  .newsletter__consent {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    margin-top: 0.9rem;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
    text-align: left;
    line-height: 1.5;
  }
  .newsletter__consent input {
    margin-top: 0.2rem;
    flex-shrink: 0;
  }
  .newsletter__consent a {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: underline;
  }
  .newsletter__msg {
    margin: 1rem 0 0;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    color: #fff;
    font-size: 0.9rem;
  }
  @media (max-width: 480px) {
    .newsletter__row {
      flex-direction: column;
    }
  }
</style>
