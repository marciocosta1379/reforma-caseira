---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featured = allPosts.filter((p) => p.data.featured).slice(0, 3);
const latest = allPosts.slice(0, 6);

const categories = [
  { slug: 'furadeiras', label: 'Furadeiras', icon: '🔩' },
  { slug: 'parafusadeiras', label: 'Parafusadeiras', icon: '🔧' },
  { slug: 'serras', label: 'Serras', icon: '🪚' },
  { slug: 'lixadeiras', label: 'Lixadeiras', icon: '⚙️' },
  { slug: 'medicao', label: 'Medição', icon: '📐' },
  { slug: 'ferramentas-manuais', label: 'Ferramentas Manuais', icon: '🔨' },
  { slug: 'jardinagem', label: 'Jardinagem', icon: '🌿' },
  { slug: 'organizacao', label: 'Organização', icon: '🗂️' },
  { slug: 'guias', label: 'Guias de Compra', icon: '📋' },
];

function formatDate(date: Date) {
  return date.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
}
---

<BaseLayout
  fullTitle="Reforma Caseira: ferramentas, reforma e marcenaria testadas"
  description="Reviews honestos e guias de reforma, elétrica, hidráulica e marcenaria: qual ferramenta comprar, como fazer o serviço e onde não vale economizar."
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__inner">
      <span class="hero__tagline">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
        Pesquisamos · Comparamos · Indicamos
      </span>
      <h1>
        As melhores <em>ferramentas</em> para<br>
        quem faz em casa
      </h1>
      <p class="hero__sub">
        Reviews honestas, comparativos detalhados e guias de compra para marcenaria
        amadora, reformas e pequenos consertos. Sem enrolação.
      </p>
      <div class="hero__actions">
        <a href="/categorias/" class="btn btn--primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          Ver categorias
        </a>
        <a href="/sobre/" class="btn btn--outline">Como avaliamos</a>
      </div>
    </div>
  </section>

  <!-- TRUST BAR -->
  <div class="trust-bar">
    <div class="trust-bar__inner">
      <span class="trust-item">
        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Reviews imparciais
      </span>
      <span class="trust-item">
        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/></svg>
        Melhor custo-benefício
      </span>
      <span class="trust-item">
        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        Atualizado regularmente
      </span>
      <span class="trust-item">
        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        Só indicamos o que vale
      </span>
    </div>
  </div>

  <!-- CATEGORIES -->
  <div class="categories-strip">
    <div class="categories-strip__inner">
      <h2>Navegar por categoria</h2>
      <ul class="cat-list">
        {categories.map((cat) => (
          <li>
            <a href={`/categorias/`}>
              <span>{cat.icon}</span>
              {cat.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- POSTS EM DESTAQUE -->
  {featured.length > 0 && (
    <section class="container section">
      <div class="section-header">
        <h2>⭐ Em destaque</h2>
        <a href="/categorias/">Ver todos →</a>
      </div>
      <div class="post-grid">
        {featured.map((post) => {
          const thumb = post.data.products?.[0]?.image;
          return (
          <article class="post-card">
            <div class="post-card__thumb">
              {thumb
                ? <img src={thumb} alt={post.data.title} loading="lazy" width="320" height="240" />
                : <span>🔧</span>
              }
            </div>
            <div class="post-card__body">
              <span class="badge badge--orange">{post.data.category}</span>
              <a href={`/posts/${post.slug}/`} class="post-card__link">
                <h3>{post.data.title}</h3>
              </a>
              <p class="post-card__excerpt">{post.data.description}</p>
              <div class="post-card__footer">
                <span class="post-card__date">{formatDate(post.data.pubDate)}</span>
                <a href={`/posts/${post.slug}/`} class="post-card__read">Ler review →</a>
              </div>
            </div>
          </article>
          );
        })}
      </div>
    </section>
  )}

  <!-- POSTS RECENTES -->
  <section class="container section" style="padding-top: 0">
    <div class="section-header">
      <h2>Publicações recentes</h2>
      {latest.length > 0 && <a href="/categorias/">Ver todos →</a>}
    </div>

    {latest.length === 0 ? (
      <div class="post-grid">
        <div class="empty-state">
          <div class="empty-state__icon">🔨</div>
          <p>Em breve os primeiros reviews. Estamos preparando conteúdo de qualidade para você!</p>
        </div>
      </div>
    ) : (
      <div class="post-grid">
        {latest.map((post) => {
          const thumb = post.data.products?.[0]?.image;
          return (
          <article class="post-card">
            <div class="post-card__thumb">
              {thumb
                ? <img src={thumb} alt={post.data.title} loading="lazy" width="320" height="240" />
                : <span>🔧</span>
              }
            </div>
            <div class="post-card__body">
              <span class="badge">{post.data.category}</span>
              <a href={`/posts/${post.slug}/`} class="post-card__link">
                <h3>{post.data.title}</h3>
              </a>
              <p class="post-card__excerpt">{post.data.description}</p>
              <div class="post-card__footer">
                <span class="post-card__date">{formatDate(post.data.pubDate)}</span>
                <a href={`/posts/${post.slug}/`} class="post-card__read">Ler review →</a>
              </div>
            </div>
          </article>
          );
        })}
      </div>
    )}
  </section>

  <!-- POR QUE NOS -->
  <section style="background: var(--color-dark); padding: 4rem 1.5rem; margin-top: 1rem;">
    <div class="container">
      <div style="text-align:center; margin-bottom: 0.5rem;">
        <span class="badge">Sobre nós</span>
      </div>
      <h2 style="text-align:center; color:#fff; margin-top: 0.75rem; margin-bottom: 0.5rem;">
        Por que confiar nas nossas reviews?
      </h2>
      <p style="text-align:center; color:rgba(255,255,255,0.65); max-width: 520px; margin: 0 auto 2.5rem; font-size:1.05rem;">
        Não escrevemos de achismos. Cada recomendação é fundamentada em pesquisa séria antes de virar review.
      </p>
      <div class="why-grid">
        <div class="why-card">
          <div class="why-card__icon why-card__icon--orange">🔍</div>
          <h3>Pesquisa Cruzada</h3>
          <p>Cruzamos specs oficiais, avaliações de compradores e reclamações antes de indicar.</p>
        </div>
        <div class="why-card">
          <div class="why-card__icon why-card__icon--teal">⚖️</div>
          <h3>Indicação por Perfil</h3>
          <p>Comparamos opções de vários orçamentos e indicamos a certa para cada necessidade.</p>
        </div>
        <div class="why-card">
          <div class="why-card__icon why-card__icon--orange">💰</div>
          <h3>Custo-Benefício Real</h3>
          <p>Levamos em conta o que o usuário doméstico realmente precisa.</p>
        </div>
        <div class="why-card">
          <div class="why-card__icon why-card__icon--teal">🔄</div>
          <h3>Sempre Atualizados</h3>
          <p>Revisamos preços e lançamentos constantemente para manter tudo atual.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
